// Cloudflare Worker for the geo-registry MCP connector (build brief, "The connector").
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "geo-registry-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // One public address only: the custom domain, never *.workers.dev.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "mcp.geo-registry.io", "custom_domain": true }],
  // Queries can contain addresses: no Workers Logs, no traces. Built-in request and CPU metrics remain.
  "observability": { "enabled": false, "logs": { "enabled": false, "invocation_logs": false } },
  "upload_source_maps": false
}
